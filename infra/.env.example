# Only for local development. Never reuse these values outside a developer machine.
POSTGRES_DB=easydentist
POSTGRES_USER=easydentist
POSTGRES_PASSWORD=easydentist-local-only
POSTGRES_HOST_PORT=5433
APP_DB_USER=easydentist_app
APP_DB_PASSWORD=easydentist-app-local-only
MIGRATION_DB_USER=easydentist_migrator
MIGRATION_DB_PASSWORD=easydentist-migrator-local-only
S3_ACCESS_KEY=easydentist
S3_SECRET_KEY=easydentist-local-only
S3_BUCKET=easydentist
S3_REGION=us-east-1
# Empty keeps document objects at the bucket root; the E2E harness overrides it
# per run with e2e/{run_id}/ so the teardown can remove exactly that prefix.
S3_KEY_PREFIX=
APP_ENV=development
AUTH_SECRET=easydentist-development-secret-not-for-production
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SMTP_SENDER=no-reply@easydentist.local
